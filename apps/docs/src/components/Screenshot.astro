---
/**
 * A screenshot from the repository, optimised at build time:
 * - demo-app screens from docs/screenshots (framed like a device screen),
 * - PDF page renders from docs/screenshots/pdf (name "pdf/<file>"), with a paper frame.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** "02-registration.png" or "pdf/invoice-page1.png". */
  name: string;
  alt: string;
  caption?: string;
  width?: number;
}

const glob = {
  ...import.meta.glob<{ default: ImageMetadata }>("../../../../docs/screenshots/*.png", { eager: true }),
  ...import.meta.glob<{ default: ImageMetadata }>("../../../../docs/screenshots/pdf/*.png", { eager: true }),
};
const { name, alt, caption, width = 300 } = Astro.props;
const path = `../../../../docs/screenshots/${name}`;
const image = glob[path]?.default;
if (!image) throw new Error(`Unknown screenshot: ${name}`);
const isPage = name.startsWith("pdf/");
---

<figure class:list={["jr-shot", "not-content", { page: isPage }]} style={`--jr-shot-width: ${width}px`}>
  <Image src={image} alt={alt} width={width * 2} densities={[1]} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .jr-shot {
    margin: 0;
    width: min(var(--jr-shot-width), 100%);
    flex: 0 1 var(--jr-shot-width);
  }
  .jr-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.75rem;
    border: 1px solid var(--sl-color-hairline-light);
    background: var(--jr-card);
  }
  .jr-shot.page img {
    border-radius: 0.25rem;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
  }
  .jr-shot figcaption {
    margin-top: 0.6rem;
    font-size: var(--sl-text-sm);
    color: var(--jr-muted);
    text-align: center;
    line-height: 1.4;
  }
</style>
