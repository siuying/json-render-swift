        "color": "#374151",
        "align": null,
        "fontWeight": null,
        "fontStyle": null,
        "lineHeight": null
      },
      "children": []
    },
    "overdue": {
      "type": "View",
      "props": {
        "padding": 8,
        "paddingTop": null,
        "paddingBottom": null,
        "paddingLeft": null,
        "paddingRight": null,
        "margin": null,
        "backgroundColor": "#fee2e2",
        "borderWidth": 1,
        "borderColor": "#dc2626",
        "borderRadius": 4,
        "flex": null,
        "alignItems": null,
        "justifyContent": null
      },
      "children": [
        "overdue-text"
      ],
      "visible": {
        "$state": "/overdue"
      }
    },
    "overdue-text": {
      "type": "Text",
      "props": {
        "text": "Your account is past due. Please make a payment immediately.",
        "fontSize": 10,
        "color": "#991b1b",
        "align": null,
        "fontWeight": "bold",
        "fontStyle": null,
        "lineHeight": null
      },
      "children": []
    },
    "notice-box": {
      "type": "View",
      "props": {
        "padding": 8,
        "paddingTop": null,
        "paddingBottom": null,
        "paddingLeft": null,
        "paddingRight": null,
        "margin": null,
        "backgroundColor": "#eff6ff",
        "borderWidth": null,
        "borderColor": null,
        "borderRadius": 4,
        "flex": null,
        "alignItems": null,
        "justifyContent": null
      },
      "children": [
        "notice-text"
      ],
      "visible": [
        {
          "$state": "/notice"
        },
        {
          "$state": "/overdue",
          "not": true
        }
      ]
    },
    "notice-text": {
      "type": "Text",
      "props": {
        "text": {
          "$state": "/notice"
        },
        "fontSize": 9,
        "color": "#1e40af",
        "align": null,
        "fontWeight": null,
        "fontStyle": "italic",
        "lineHeight": null
      },
      "children": []
    },
    "summary-heading": {
      "type": "Heading",
      "props": {
        "text": "Summary",
        "level": "h3",
        "color": null,
        "align": null
      },
      "children": []
    },
    "summary-table": {
      "type": "Table",
      "props": {
        "columns": [
          {
            "header": "Account",
            "width": "40%",
            "align": null
          },
          {
            "header": "Number",
            "width": "20%",
            "align": null
          },
          {
            "header": "Opening",
            "width": "20%",
            "align": "right"
          },
          {
            "header": "Closing",
            "width": "20%",
            "align": "right"
          }
        ],
        "rows": {
          "$state": "/summary/rows"
        },
        "headerBackgroundColor": "#1e3a8a",
        "headerTextColor": "#ffffff",
        "borderColor": null,
        "fontSize": 10,
        "striped": true
      },
      "children": []
    },
    "accounts": {
      "type": "Column",
      "props": {
        "gap": 14,
        "alignItems": null,
        "justifyContent": null,
        "padding": null,
        "flex": null
      },
      "children": [
        "account"
      ],
      "repeat": {
        "statePath": "/accounts",
        "key": "id"
      }
    },
    "account": {
      "type": "Column",
      "props": {
        "gap": 4,
        "alignItems": null,
        "justifyContent": null,
        "padding": null,
        "flex": null
