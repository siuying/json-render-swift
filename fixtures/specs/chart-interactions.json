{
  "root": "form",
  "elements": {
    "form": {
      "type": "Form",
      "props": {
        "title": "Tap a chart"
      },
      "children": [
        "section"
      ]
    },
    "section": {
      "type": "Section",
      "props": {},
      "children": [
        "selection",
        "chart",
        "notes"
      ]
    },
    "selection": {
      "type": "Text",
      "props": {
        "content": {
          "$template": "Tapped datum: ${/selected/label}, value ${/selected/value}"
        }
      },
      "children": []
    },
    "chart": {
      "type": "BarChart",
      "props": {
        "data": {
          "$state": "/rows"
        },
        "xKey": "region",
        "yKey": "sales",
        "height": 240,
        "title": "Sales by region",
        "horizontal": true,
        "maxCategories": 3,
        "accessibilitySummary": "West leads. The remaining regions are combined into Other."
      },
      "children": [],
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/selected",
            "value": {
              "$datum": ""
            }
          }
        }
      }
    },
    "notes": {
      "type": "TextField",
      "props": {
        "label": "Notes",
        "value": {
          "$bindState": "/form/notes"
        },
        "checks": [
          {
            "type": "maxLength",
            "args": {
              "max": 500
            },
            "message": "Keep notes to 500 characters."
          }
        ]
      },
      "children": []
    }
  },
  "state": {
    "rows": [
      {
        "region": "Western region and coastal communities",
        "sales": 12
      },
      {
        "region": "Eastern region and metropolitan districts",
        "sales": 8
      },
      {
        "region": "Northern region",
        "sales": 6
      },
      {
        "region": "Southern region",
        "sales": 4
      }
    ],
    "selected": {
      "label": "Tap a mark",
      "value": 0
    },
    "form": {
      "notes": ""
    }
  }
}
