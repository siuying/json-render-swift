{
  "root": "doc",
  "elements": {
    "doc": {
      "type": "Document",
      "props": {
        "title": {
          "$template": "Statement - ${/period/label}"
        },
        "author": {
          "$state": "/bank/name"
        },
        "subject": "Monthly account statement"
      },
      "children": [
        "page"
      ]
    },
    "page": {
      "type": "Page",
      "props": {
        "size": "LETTER",
        "orientation": "portrait",
        "marginTop": 40,
        "marginBottom": 50,
        "marginLeft": 44,
        "marginRight": 44,
        "backgroundColor": null
      },
      "children": [
        "header",
        "header-divider",
        "customer-row",
        "overdue",
        "notice-box",
        "summary-heading",
        "summary-table",
        "accounts",
        "closing-note",
        "page-number"
      ]
    },
    "header": {
      "type": "Row",
      "props": {
        "gap": null,
        "alignItems": "flex-start",
        "justifyContent": "space-between",
        "padding": null,
        "flex": null,
        "wrap": null
      },
      "children": [
        "bank-col",
        "period-col"
      ]
    },
    "bank-col": {
      "type": "Column",
      "props": {
        "gap": 2,
        "alignItems": null,
        "justifyContent": null,
        "padding": null,
        "flex": null
      },
      "children": [
        "bank-name",
        "bank-address"
      ]
    },
    "bank-name": {
      "type": "Heading",
      "props": {
        "text": {
          "$state": "/bank/name"
        },
        "level": "h1",
        "color": "#1e3a8a",
        "align": null
      },
      "children": []
    },
    "bank-address": {
      "type": "Text",
      "props": {
        "text": {
          "$template": "${/bank/address} | ${/bank/phone}"
        },
        "fontSize": 9,
        "color": "#6b7280",
        "align": null,
        "fontWeight": null,
        "fontStyle": null,
        "lineHeight": null
      },
      "children": []
    },
    "period-col": {
      "type": "Column",
      "props": {
        "gap": 2,
        "alignItems": "flex-end",
        "justifyContent": null,
        "padding": null,
        "flex": null
      },
      "children": [
        "period-title",
        "period-label",
        "period-issued"
      ]
    },
    "period-title": {
      "type": "Text",
      "props": {
        "text": "ACCOUNT STATEMENT",
        "fontSize": 10,
        "color": "#1e3a8a",
        "align": null,
        "fontWeight": "bold",
        "fontStyle": null,
        "lineHeight": null
      },
      "children": []
    },
    "period-label": {
      "type": "Text",
      "props": {
        "text": {
          "$state": "/period/label"
        },
        "fontSize": 10,
        "color": null,
        "align": null,
        "fontWeight": null,
        "fontStyle": null,
        "lineHeight": null
      },
      "children": []
    },
    "period-issued": {
      "type": "Text",
      "props": {
        "text": {
          "$template": "Issued ${/period/issued}"
        },
        "fontSize": 9,
        "color": "#6b7280",
        "align": null,
        "fontWeight": null,
        "fontStyle": null,
        "lineHeight": null
      },
      "children": []
    },
    "header-divider": {
      "type": "Divider",
      "props": {
        "color": "#1e3a8a",
        "thickness": 2,
        "marginTop": 10,
        "marginBottom": 12
      },
      "children": []
    },
    "customer-row": {
      "type": "Row",
      "props": {
        "gap": 24,
        "alignItems": null,
        "justifyContent": null,
        "padding": null,
        "flex": null,
        "wrap": null
      },
      "children": [
        "customer-name",
        "customer-address",
        "customer-since"
      ]
    },
    "customer-name": {
      "type": "Text",
      "props": {
        "text": {
          "$state": "/customer/name"
