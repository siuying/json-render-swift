---
/**
 * Embeds a file from the repository at build time (fixtures and generated samples), so
 * the docs always show the real file instead of a copy.
 *
 *   <RepoFile path="fixtures/specs/registration.json" />
 *   <RepoFile path="fixtures/specs/registration.json" elements={["email", "company"]} />
 */
import { Code } from "@astrojs/starlight/components";

interface Props {
  /** Repo-relative path: fixtures/specs/*, fixtures/pdf/*.json(l), docs/system-prompt.sample.txt or docs/system-prompt-pdf.sample.txt. */
  path: string;
  /** Show only these elements of a spec (as an `elements` excerpt). */
  elements?: string[];
  /** Show only the spec's initial `state`. */
  stateOnly?: boolean;
  /** Show only the first N lines. */
  lines?: number;
  title?: string;
  lang?: string;
}

const files = {
  ...import.meta.glob<string>("../../../../fixtures/specs/*", {
    query: "?raw",
    import: "default",
    eager: true,
  }),
  ...import.meta.glob<string>("../../../../fixtures/pdf/*.{json,jsonl}", {
    query: "?raw",
    import: "default",
    eager: true,
  }),
  ...import.meta.glob<string>("../../../../docs/system-prompt*.sample.txt", {
    query: "?raw",
    import: "default",
    eager: true,
  }),
};

const { path, elements, stateOnly, lines, title, lang } = Astro.props;
const raw = files[`../../../../${path}`];
if (raw === undefined) throw new Error(`RepoFile: ${path} is not embeddable`);

let code = raw.trimEnd();
let codeLang = lang ?? (path.endsWith(".json") ? "json" : path.endsWith(".jsonl") ? "json" : "text");
if (elements || stateOnly) {
  const spec = JSON.parse(raw);
  if (stateOnly) {
    code = JSON.stringify({ state: spec.state }, null, 2);
  } else {
    const picked = Object.fromEntries(
      elements!.map((key) => {
        if (!(key in spec.elements)) throw new Error(`RepoFile: ${path} has no element "${key}"`);
        return [key, spec.elements[key]];
      }),
    );
    code = JSON.stringify({ elements: picked }, null, 2);
  }
}
if (lines !== undefined) {
  const all = code.split("\n");
  code = all.slice(0, lines).join("\n") + (all.length > lines ? `\n…` : "");
}
const excerpt = elements || stateOnly || lines !== undefined;
---

<Code code={code} lang={codeLang} title={title ?? (excerpt ? `${path} (excerpt)` : path)} />
