        "fontSize": 11,
        "color": null,
        "align": null,
        "fontWeight": "bold",
        "fontStyle": null,
        "lineHeight": null
      },
      "children": []
    },
    "customer-address": {
      "type": "Text",
      "props": {
        "text": {
          "$state": "/customer/address"
