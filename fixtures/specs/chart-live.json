{
  "root": "form",
  "elements": {
    "form": {
      "type": "Form",
      "props": {
        "title": "Live chart updates"
      },
      "children": [
        "section"
      ]
    },
    "section": {
      "type": "Section",
      "props": {},
      "children": [
        "orientation",
        "empty",
        "restore",
        "selection",
        "chart",
        "notes"
      ]
    },
    "orientation": {
      "type": "Toggle",
      "props": {
        "label": "Horizontal bars",
        "isOn": {
          "$bindState": "/horizontal"
        }
      },
      "children": []
    },
    "empty": {
      "type": "Button",
      "props": {
        "label": "Clear data"
      },
      "children": [],
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/rows",
            "value": []
          }
        }
      }
    },
    "restore": {
      "type": "Button",
      "props": {
        "label": "Load mixed data"
      },
      "children": [],
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/rows",
            "value": [
              {
                "region": "Western region and coastal communities",
                "sales": 12
              },
              {
                "region": "Eastern region and metropolitan districts",
                "sales": 8
              },
              {
                "region": "Northern region",
                "sales": 6
              },
              {
                "region": "Southern region",
                "sales": 4
              },
              {
                "region": "Invalid value is skipped",
                "sales": "not a number"
              }
            ]
          }
        }
      }
    },
    "chart": {
      "type": "BarChart",
      "props": {
        "data": {
          "$state": "/rows"
        },
        "xKey": "region",
        "yKey": "sales",
        "height": 240,
        "title": "Live sales",
        "horizontal": {
          "$state": "/horizontal"
        }
      },
      "children": [],
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/selected",
            "value": {
              "$datum": ""
            }
          }
        }
      }
    },
    "selection": {
      "type": "Text",
      "props": {
        "content": {
          "$template": "Tapped datum: ${/selected/label}, value ${/selected/value}"
        }
      },
      "children": []
    },
    "notes": {
      "type": "TextField",
      "props": {
        "label": "Notes",
        "value": {
          "$bindState": "/form/notes"
        },
        "checks": [
          {
            "type": "maxLength",
            "args": {
              "max": 500
            },
            "message": "Keep notes to 500 characters."
          }
        ]
      },
      "children": []
    }
  },
  "state": {
    "rows": [],
    "horizontal": false,
    "selected": {
      "label": "Tap a mark",
      "value": 0
    },
    "form": {
      "notes": ""
    }
  }
}
