{
  "name": "@json-render/swift",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "SwiftUI forms and PDF catalogs for @json-render/core, plus a JavaScriptCore bridge bundle for the native Swift SDK.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "require": "./dist/catalog.cjs"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "require": "./dist/pdf.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-bridge.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "gen:fixtures": "tsx scripts/gen-parity-fixtures.ts",
    "gen:prompt": "tsx scripts/gen-system-prompt.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "extract:pdf-examples": "tsx scripts/extract-pdf-examples.ts",
    "render:pdf-references": "tsx scripts/render-pdf-references.ts",
    "gen:pdf-stream": "tsx scripts/gen-pdf-stream.ts"
  },
  "dependencies": {
    "@json-render/core": "0.21.3",
    "@json-render/react-pdf": "0.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-pdf/renderer": "4.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.0",
    "react": "^19.3.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.2",
    "vitest": "^4.0.17"
  }
}
